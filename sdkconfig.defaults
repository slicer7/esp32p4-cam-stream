# ---- target ----------------------------------------------------------------
CONFIG_IDF_TARGET="esp32p4"

# ---- chip revision --------------------------------------------------------
# This board's ESP32-P4 is revision v1.3. IDF defaults to requiring rev v3.1 and
# the firmware refuses to boot on an older chip, so select the <3.0 family and
# a v1.0 minimum. Note this also removes the 250 MHz PSRAM option (200 MHz,
# configured below, is still available).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# ---- CPU / PSRAM -----------------------------------------------------------
# The P4 module on the Waveshare board has HEX (16-bit) PSRAM. If the board
# reports a PSRAM init failure, try QUAD mode / a lower speed in menuconfig.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- flash -----------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# The ESP32-P4 bootloader with esp_hosted/PSRAM support exceeds the 0x6000 that
# the default 0x8000 table offset allows, so move the table out to 0xA000.
CONFIG_PARTITION_TABLE_OFFSET=0xA000

# ---- camera ----------------------------------------------------------------
# OV5647 is the sensor on the Raspberry Pi camera module.
CONFIG_CAMERA_OV5647=y

# Each sensor mode has to be COMPILED IN here before the app can request it.
# Asking for a resolution in "P4 Camera Stream Configuration" is not enough: if
# the mode is not built, VIDIOC_S_FMT is rejected and the app quietly falls back
# to the sensor default. Enable all five so the boot-time enumeration is honest
# and switching resolution needs no driver change.
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X640_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X800_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X1280_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1920X1080_30FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS=y

# 1280x960 binning is the full-field-of-view mode; make it the sensor default so
# even the fallback path keeps the whole 120 degrees. (Index 4.)
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1280X960_BINNING_45FPS=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y

# ---- tasks / stacks --------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# ---- networking throughput -------------------------------------------------
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
CONFIG_LWIP_TCP_WND_DEFAULT=65535
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_MAXRTX=6
CONFIG_LWIP_SO_LINGER=y

# ---- log -------------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
